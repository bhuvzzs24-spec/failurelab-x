API_TOKEN=change-local-api-token
CONTROL_TOKEN=change-local-control-token
POSTGRES_PASSWORD=change-lab-password
DEMO_POSTGRES_PASSWORD=change-demo-password
BUILD_VERSION=phase4-local

# Optional local Ollama proposals (disabled when empty).
OLLAMA_URL=
OLLAMA_MODEL=qwen3:8b
# Worker-side address of the separately operated restricted sandbox agent.
REPAIR_AGENT_URL=
REPAIR_AGENT_TOKEN=

# Local by default. Hosted APIs require distinct random role tokens >=32 chars.
APP_MODE=local
AUTH_VIEWER_TOKEN=
AUTH_OPERATOR_TOKEN=
AUTH_ADMIN_TOKEN=
MUTATIONS_PER_MINUTE=30
# Optional Compose verification profile: configured by make verifier, never public.
REPAIR_HOST_INPUT_ROOT=
LOCAL_UID=10001
LOCAL_GID=10001
DOCKER_GID=0

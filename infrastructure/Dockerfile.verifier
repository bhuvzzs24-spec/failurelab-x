FROM python:3.12-slim
WORKDIR /runtime
COPY pyproject.toml constraints.txt .
COPY backend ./backend
RUN pip install --no-cache-dir -c constraints.txt . && useradd --uid 10001 --create-home sandbox
COPY backend/app /runtime/app
ENV PYTHONPATH=/runtime PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
ENTRYPOINT ["python", "-m", "app.repair.container_entry"]

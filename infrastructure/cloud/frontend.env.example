# Set in Vercel's server-side Production environment; never NEXT_PUBLIC_.
DEPLOYMENT_ENV=cloud
ACCESS_MODE=read_only
PUBLIC_FRONTEND_ORIGIN=https://replace-with-approved-frontend.invalid
BACKEND_URL=https://replace-with-provisioned-api.invalid
HOSTED_BACKEND_ORIGIN=https://replace-with-provisioned-api.invalid
API_TOKEN=
# API_TOKEN must be the same random >=32-character AUTH_VIEWER_TOKEN as the
# read-only backend. No operator/admin/control/owner credential goes here.

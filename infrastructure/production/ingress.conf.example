# Nginx TLS server fragment; supply actual certificates and identity-aware ingress.
# Read-only API only. Execution infrastructure and the agent have no public ingress.
limit_req_zone $binary_remote_addr zone=readonly:10m rate=10r/s;
server {
    listen 443 ssl;
    server_name readonly-api.your-domain.invalid;
    ssl_certificate /run/secrets/tls_cert;
    ssl_certificate_key /run/secrets/tls_key;
    client_max_body_size 64k;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    location / {
        limit_except GET HEAD { deny all; }
        limit_req zone=readonly burst=20 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Configure a known-proxy IP allowlist in Uvicorn before trusting forwarded IPs.
    }
}
